# Ayekoo dataset pipeline configuration (EXAMPLE).
# Copy to config.env and edit, then:  set -a; . ./config.env; set +a
# All variables are optional; each script falls back to the defaults shown.

# Root of the working project on the machine that owns the data / GPU.
# Every intermediate directory (videos/, frames/, no_people/, masks/, inpainted/,
# logs/) lives directly under this path.
AYEKOO_PROJECT_DIR=/mnt/volume_d2wey28/projects/ayekoo-videos

# Same directory as seen from the SSH download/worker host (used by the
# residential-IP download scripts). Usually equals AYEKOO_PROJECT_DIR.
AYEKOO_REMOTE_DIR=/mnt/volume_d2wey28/projects/ayekoo-videos

# Local staging directory for the residential-IP download helper.
AYEKOO_STAGE_DIR=/media/yourname/ayekoo_stage

# Local checkout used by local_finalize_monitor.sh.
AYEKOO_LOCAL_DIR=/media/yourname/NLP-Projects/ayekoo-videos

# SSH alias of the GPU/download host (see ~/.ssh/config).
AYEKOO_REMOTE_HOST=h200

# HuggingFace cache for the Qwen vision models.
HF_HOME=/mnt/volume_d2wey28/hf_cache

# Gemini API key file (relative to AYEKOO_PROJECT_DIR). Never commit the key.
AYEKOO_GEMINI_KEY_FILE=.secrets/gemini_key

# Gemini model used for overlay detection.
AYEKOO_GEMINI_MODEL=gemini-3.5-flash-lite

# HuggingFace dataset repo to publish the final dataset to.
AYEKOO_HF_REPO=ghanaopenai/ayekoo

# HuggingFace token with write access (export in your shell; never commit).
# HF_TOKEN=hf_xxx
